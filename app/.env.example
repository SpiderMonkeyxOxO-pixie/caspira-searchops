# Supabase project credentials (required for local dev)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Client ID (required for GSC + GA4 integrations)
# Create at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# NOTE: All API keys (Anthropic, Serper, DataForSEO, etc.) are entered
# via the Settings modal at runtime and stored in localStorage only.
# They are NOT set via .env files.
